pipeline {
    agent any
    environment {
        DOCKER_IMAGE_NAME = 'myapp-image'
        CONTAINER_NAME = 'myapp'
        REPO_URL = 'https://github.com/LaSkyMania/projet-Devops.git'
        BRANCH_NAME = 'main'
    }
    stages {
        stage('Clean Workspace') {
            steps {
                script {
                    deleteDir()  // Nettoie le workspace avant chaque exécution
                }
            }
        }
        stage('Clone GitHub Repo') {
            steps {
                script {
                    // Clone le repository GitHub
                    git branch: "${BRANCH_NAME}", url: "${REPO_URL}"
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    // Construire l'image Docker
                    sh "docker build -t ${DOCKER_IMAGE_NAME} ."
                    
                    // Vérifier la construction de l'image
                    sh "docker images ${DOCKER_IMAGE_NAME}"
                }
            }
        }
        stage('Deploy Container') {
            steps {
                script {
                    // Suppression des anciens conteneurs si nécessaire
                    def containers = sh(script: 'docker ps -a -q', returnStdout: true).trim()
                    if (containers) {
                        sh "docker rm -f ${containers}"
                    }

                    // Lancer le conteneur à partir de l'image construite
                    echo "Lancement du conteneur..."
                    sh "docker run -d --name ${CONTAINER_NAME} -p 8088:80 ${DOCKER_IMAGE_NAME}"
                    
                    // Récupérer l'IP du conteneur
                    def containerIp = sh(script: "docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' ${CONTAINER_NAME}", returnStdout: true).trim()
                    echo "Le conteneur est déployé avec succès. L'IP du conteneur est : ${containerIp}"
                }
            }
        }
    }
    post {
        always {
            echo 'Pipeline terminée.'
        }
    }
}
